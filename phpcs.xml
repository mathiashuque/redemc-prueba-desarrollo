<?xml version="1.0"?>
<ruleset name="redemc">
    <description>Estándar de código del proyecto: PSR-12.</description>

    <file>bin</file>
    <file>public</file>
    <file>src</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- Los endpoints y scripts son archivos de entrada: ejecutan código a propósito. -->
    <rule ref="PSR1.Files.SideEffects.FoundWithSymbols">
        <exclude-pattern>bin/*</exclude-pattern>
        <exclude-pattern>public/*</exclude-pattern>
    </rule>
</ruleset>
