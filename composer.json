{
    "name": "mathiashuque/redemc-prueba-desarrollo",
    "description": "Prueba técnica RedEMC: registro y listado de contactos con PHP, jQuery y MySQL.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "ext-json": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*"
    },
    "require-dev": {
        "php-parallel-lint/php-parallel-lint": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.11"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "scripts": {
        "lint": "parallel-lint src public bin tests",
        "cs": "phpcs",
        "cs:fix": "phpcbf",
        "stan": "phpstan analyse --memory-limit=512M --no-progress",
        "test": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "check": [
            "@lint",
            "@cs",
            "@stan",
            "@test"
        ]
    }
}
