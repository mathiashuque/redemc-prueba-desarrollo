# Copiá este archivo a .env para cambiar los valores locales de docker compose.
# Son valores de desarrollo, no credenciales reales. Nunca subas .env al repositorio.
APP_PORT=8080
DB_NAME=redemc
DB_USER=redemc
DB_PASSWORD=redemc
DB_ROOT_PASSWORD=root
DB_PORT_HOST=3307

# En Railway, el servicio de la app usa DB_HOST, DB_PORT, DB_NAME, DB_USER y
# DB_PASSWORD referenciando al servicio MySQL (ver README). También funcionan
# directamente MYSQLHOST, MYSQLPORT, MYSQLDATABASE, MYSQLUSER y MYSQLPASSWORD.
